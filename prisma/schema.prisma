generator client {
  provider      = "prisma-client-js"
  // "native" para desarrollo local; "rhel-openssl-3.0.x" para las funciones
  // serverless de Netlify (AWS Lambda / Amazon Linux 2023).
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Reserva {
  id             Int      @id @default(autoincrement())
  createdAt      DateTime @default(now())

  // Cliente
  nombre         String
  email          String
  telefono       String?
  direccion      String

  // Servicio
  servicio       String   // '100m2' | '200m2' | '300m2' | '300m2plus'
  servicioNombre String
  conHostingWeb  Boolean  @default(false)
  precio         Decimal? @db.Decimal(10, 2)

  // Visita
  fechaVisita    DateTime?
  horaVisita     String?

  // Pago
  estadoPago     String   @default("pendiente") // 'pendiente' | 'completado' | 'fallido'
  metodoPago     String?  // 'stripe' | 'paypal'
  stripeId       String?  // PaymentIntent ID de Stripe
  paypalId       String?

  // Hosting anual del tour (suscripción de Stripe)
  stripeCustomerId     String?
  stripeSubscriptionId String?   @unique
  hostingEstado        String?   // 'activo' | 'cancela_al_vencer' | 'impago' | 'cancelado'
  hostingVenceEl       DateTime?

  // Tour
  estadoTour     String   @default("pendiente") // 'pendiente' | 'en_proceso' | 'completado' | 'entregado'
  notas          String?  @db.Text

  // Archivo de tours (panel /admin/tours)
  categoria      String?  // 'inmobiliaria' | 'particular' | 'empresa' | 'hosteleria'
  enlaceTour     String?  // enlace al tour 360 ya subido (Google Maps, web, etc.)
  creadaManual   Boolean  @default(false) // true si se añadió a mano desde el admin, no desde una reserva online

  @@map("reservas")
}

model Contacto {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())

  nombre      String
  apellido    String?
  email       String
  telefono    String?
  empresa     String?
  posicion    String?
  mensaje     String   @db.Text
  tipo        String   @default("contacto") // 'contacto' | 'presupuesto_plus300' | 'inmobiliaria'

  @@map("contactos")
}

// Solicitud de tours de una agencia inmobiliaria (formulario /inmobiliarias/solicitud).
model SolicitudAgencia {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  agencia  String
  contacto String
  email    String
  telefono String
  tramo    String // tramo declarado para el primer mes: 'start' | 'pro' | 'business' | 'a_medida'
  notas    String? @db.Text

  // Quiere alojar todos sus tours en nuestro servidor (cuota anual única, no se suma a importeEstimado)
  conHosting Boolean @default(false)

  // null si el tramo es "a medida" (se presupuesta aparte)
  importeEstimado Decimal? @db.Decimal(10, 2)
  estado          String   @default("nueva") // 'nueva' | 'presupuestada' | 'agendada' | 'completada' | 'descartada'

  // Cobro con el enlace de pago generado en /admin/solicitudes. Importes con IVA incluido.
  importeTours         Decimal?  @db.Decimal(10, 2) // importe final acordado de los tours
  tokenPago            String?   @unique // parte secreta del enlace /pago/<token>
  estadoPago           String    @default("sin_enlace") // 'sin_enlace' | 'pendiente' | 'pagada'
  pagadaEl             DateTime?
  stripeCheckoutId     String?
  stripeCustomerId     String?
  stripeSubscriptionId String?   @unique
  hostingEstado        String? // 'activo' | 'cancela_al_vencer' | 'impago' | 'cancelado'
  hostingVenceEl       DateTime?

  inmuebles InmuebleSolicitud[]

  @@map("solicitudes_agencia")
}

model InmuebleSolicitud {
  id          Int              @id @default(autoincrement())
  solicitudId Int
  solicitud   SolicitudAgencia @relation(fields: [solicitudId], references: [id], onDelete: Cascade)

  direccion       String
  metros          Int
  disponibleDesde DateTime @db.Date
  franja          String // 'manana' | 'tarde' | 'indiferente'
  precioEstimado  Decimal? @db.Decimal(10, 2)

  @@index([solicitudId])
  @@map("inmuebles_solicitud")
}
